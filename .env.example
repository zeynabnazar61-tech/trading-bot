# Kopiere diese Datei zu ".env" und trage dort deine echten Keys ein.
# Die ".env" Datei NIEMALS auf GitHub hochladen (sie steht in .gitignore)!

# Alpaca Paper-Trading Keys (von https://app.alpaca.markets)
ALPACA_API_KEY=dein_paper_api_key_hier
ALPACA_SECRET_KEY=dein_paper_secret_key_hier

# true = Paper-Trading (Fake-Geld), false = Live-Trading (ECHTES GELD)
ALPACA_PAPER=true

# Optional: Telegram-Benachrichtigungen bei Trades
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Sentry-Fehlerüberwachung (DSN aus deinem Sentry-Projekt)
SENTRY_DSN=
